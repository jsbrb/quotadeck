{
  "manifest_version": 3,
  "name": "quotadeck",
  "version": "0.1.0",
  "description": "Provider usage and balance badge",
  "action": {
    "default_title": "quotadeck",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://api.z.ai/*",
    "https://open.bigmodel.cn/*"
  ]
}
